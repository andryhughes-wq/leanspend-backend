# ╔══════════════════════════════════════════════════════════════════╗
# ║              LeanSpend — Fill In & Save                         ║
# ║  Only GROQ_API_KEY and DB_PASSWORD are required to start        ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────
#  SERVER
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_NAME=LeanSpend

# ─────────────────────────────────────────────
#  DATABASE  (PostgreSQL)
#  Run these commands to set up:
#    createdb leanspend
#    createuser leanspend_user
#    psql -c "ALTER USER leanspend_user WITH PASSWORD 'yourpassword';"
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leanspend
DB_USER=leanspend_user
DB_PASSWORD=leanspend123

# ─────────────────────────────────────────────
#  REDIS CACHE
#  Windows: download from https://github.com/microsoftarchive/redis/releases
#  Run redis-server.exe after installing
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────
#  GROQ AI  ← REQUIRED (FREE)
#  1. Go to https://console.groq.com
#  2. Sign up free (Google or email)
#  3. Click API Keys → Create API Key
#  4. Paste below (starts with gsk_...)
# ─────────────────────────────────────────────
GROQ_API_KEY=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

# ─────────────────────────────────────────────
#  USDA NUTRITION  (free — no key needed to start)
#  Full access: https://fdc.nal.usda.gov/api-guide.html
# ─────────────────────────────────────────────
USDA_API_KEY=DEMO_KEY

# ─────────────────────────────────────────────
#  KROGER API  (optional — real store deals)
#  Register free at https://developer.kroger.com
# ─────────────────────────────────────────────
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_BASE_URL=https://api.kroger.com/v1

# ─────────────────────────────────────────────
#  WALMART API  (optional — rollback prices)
#  Register free at https://developer.walmart.com
# ─────────────────────────────────────────────
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
WALMART_BASE_URL=https://developer.api.walmart.com

# ─────────────────────────────────────────────
#  TELEGRAM BOT  (optional)
#  1. Message @BotFather on Telegram
#  2. Send /newbot → follow steps → paste token below
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# ─────────────────────────────────────────────
#  THEME / BRANDING
# ─────────────────────────────────────────────
DEFAULT_THEME_COLOR=#6BCB77
APP_TAGLINE=Eat lean. Spend less. Live fit.

# ─────────────────────────────────────────────
#  SETTINGS
# ─────────────────────────────────────────────
SCRAPE_HEB=true
SCRAPE_TARGET=true
DEAL_REFRESH_INTERVAL=60
JWT_SECRET=change_this_to_any_long_random_string
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
